{
  "manifest_version": 3,
  "name": "Benim AdBlockerım",
  "version": "1.0",
  "description": "Sayfalardaki reklamları otomatik gizleyen özel eklentim.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ]
}